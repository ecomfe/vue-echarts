{
  "name": "vue-echarts",
  "version": "8.3.0",
  "description": "Vue.js component for Apache ECharts™.",
  "license": "MIT",
  "author": "GU Yiling <justice360@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecomfe/vue-echarts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.min.js",
  "jsdelivr": "dist/index.min.js",
  "exports": {
    ".": "./dist/index.js",
    "./style.css": "./dist/style.css",
    "./graphic": {
      "types": "./dist/graphic.d.ts",
      "default": "./dist/graphic.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown && tsc -p tsconfig.package.json && tsc -p tsconfig.package-echarts.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.vitest.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "publint": "publint",
    "dev:build": "vite build",
    "dev:preview": "vite preview",
    "dev:typecheck": "vue-tsc -p ./demo",
    "test:setup": "playwright install chromium",
    "docs": "jiti ./scripts/docs.ts",
    "release": "bumpp --execute \"pnpm run docs\" --all",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:browser": "vitest run --project browser",
    "test:node": "vitest run --project node"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vue/runtime-core-3.3": "npm:@vue/runtime-core@3.3.0",
    "@vue/server-renderer": "^3.5.41",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "bumpp": "^12.2.1",
    "comment-mark": "^2.0.1",
    "echarts": "^6.1.0",
    "echarts-6.0": "npm:echarts@6.0.0",
    "echarts-gl": "^2.1.0",
    "jiti": "^2.7.0",
    "lefthook": "^2.1.10",
    "monaco-editor": "0.54.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.81.0",
    "pinia": "^4.0.3",
    "playwright": "^1.62.1",
    "postcss-nested": "^8.0.1",
    "publint": "^0.3.24",
    "releaselog": "^8.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "unplugin-raw": "^0.7.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-vue": "^2.1.0",
    "vue": "^3.5.41",
    "vue-component-type-helpers": "^3.3.11",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "echarts": "^6.0.0",
    "vue": "^3.3.0"
  },
  "packageManager": "pnpm@11.24.0"
}
